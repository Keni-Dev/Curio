# Demo Mode Environment Configuration
# Use this file for offline presentations and demos
# Copy to .env or .env.local before running: npm run dev

# =============================================================================
# DEMO MODE
# =============================================================================
# Enable demo mode - uses mock data, skips real Supabase calls
VITE_DEMO_MODE=true

# =============================================================================
# Supabase Configuration (Dummy values for demo)
# These are required by the app but won't be used in demo mode
# =============================================================================
VITE_SUPABASE_URL=https://demo.supabase.co
VITE_SUPABASE_ANON_KEY=demo-key-not-used-in-demo-mode

# =============================================================================
# Map Defaults (Malolos, Bulacan - Demo Location)
# =============================================================================
VITE_MAP_DEFAULT_LAT=14.8527
VITE_MAP_DEFAULT_LNG=120.8150
VITE_MAP_DEFAULT_ZOOM=15

# =============================================================================
# AI Services (Disabled in demo - using pre-scripted responses)
# =============================================================================
# VITE_OPENROUTER_API_KEY=
# VITE_GEMINI_API_KEY=

# =============================================================================
# Feature Flags (All enabled for demo)
# =============================================================================
VITE_ENABLE_OCR=true
VITE_ENABLE_MEDI_BOT=true
VITE_ENABLE_OFFLINE_MODE=true

# =============================================================================
# Demo Notes
# =============================================================================
# When demo mode is active:
# 1. All Supabase calls return mock data from demoData.ts
# 2. Authentication auto-logs in with "Demo User"
# 3. OCR returns pre-scripted prescription results
# 4. MediBot returns pre-scripted health responses
# 5. Stock reports are stored locally (IndexedDB) only
# 6. No internet connection required (except for map tiles)
#
# To switch between demo and live mode:
# - Use the DevTools panel (bottom-right gear icon)
# - Toggle "Full Demo Mode" on/off
# - Or set VITE_DEMO_MODE=false and use real credentials
